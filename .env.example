# .env.example - Template for environment variables
# Copy this to .env and fill in your actual values
# NEVER commit .env to Git!
# --- API Authentication ---
# Shared secret between RPi edge device and laptop server
API_KEY=your_secure_random_api_key_here
# Secret key for signing JWT tokens (generate a random 64-char string)
JWT_SECRET_KEY=your_jwt_secret_key_here
# --- Email (SMTP) Configuration ---
# Gmail: enable 2FA, then create an App Password (16 chars) and use it below.
# Microsoft 365 / Live@AUL: use SMTP_HOST=smtp.office365.com (port 587).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
ALERT_EMAIL_RECIPIENTS=manager1@hotel.com,manager2@hotel.com
# STARTTLS toggle. Leave "true" for Gmail/Office365 on :587. Set "false" only
# for a plain in-house relay on :25 (or the local capture server used by
# `python -m scripts.verify_email_latency`). Auth is skipped automatically
# when SMTP_USERNAME/SMTP_PASSWORD are blank.
SMTP_USE_TLS=true
# Branded "From" display name shown in the recipient's inbox. Lets a generic
# gmail.com service mailbox still appear as a professional sender.
SMTP_FROM_NAME=Smart Reception
# --- Twilio (SMS / WhatsApp) Configuration ---
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
# Channel: "sms" (default) or "whatsapp" (Twilio WhatsApp Sandbox).
TWILIO_CHANNEL=whatsapp
# For WhatsApp Sandbox use Twilio's shared sandbox number below.
# For SMS, use your Twilio trial phone number instead (e.g. +1234567890).
TWILIO_FROM_NUMBER=+14155238886
# Recipients must have joined the sandbox ("join <code>") and, on a trial
# account, be verified. Prefix is added automatically for WhatsApp.
ALERT_SMS_RECIPIENTS=+9611234567,+9617654321
# --- Encryption Key (for facial embedding encryption at rest) ---
ENCRYPTION_KEY=your_32_byte_base64_key_here
# --- Default Admin Account (change password after first login!) ---
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change_me_immediately